{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/estimation",
      "destination": "/demande-estimation/",
      "permanent": true
    },
    {
      "source": "/estimation/",
      "destination": "/demande-estimation/",
      "permanent": true
    },
    {
      "source": "/estimation/index.html",
      "destination": "/demande-estimation/",
      "permanent": true
    }
  ]
}
